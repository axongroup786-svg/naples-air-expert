# ---------------------------------------------------------------------------
# Naples Air Experts — environment variables
# Copy this file to `.env` for local development, and add the same keys in
# Netlify (Site settings > Environment variables) or Cloudflare Pages
# (Settings > Variables) for production.
# ---------------------------------------------------------------------------

# Required: any PostgreSQL connection string.
# Free options that work on BOTH Netlify and Cloudflare:
#   - Neon      (https://neon.tech)
#   - Supabase  (https://supabase.com)
#   - Railway / Aiven / AWS RDS
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional lead-capture fallback.
# If the database is unreachable, the form POSTs the lead here instead
# (Formspree, Make.com, Zapier, Google Apps Script, a webhook relay, etc.).
# Leave empty to disable.
LEAD_WEBHOOK_URL=

# Required by Next.js metadata / JSON-LD canonical + sitemap URLs.
# Change this to your real production domain after you first deploy.
NEXT_PUBLIC_SITE_URL=https://www.naplesairexperts.com
